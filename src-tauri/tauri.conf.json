{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Margin Mail",
  "version": "0.0.4",
  "identifier": "studio.margin.mail",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "node scripts/prepare-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 9,
          "y": 25
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "studio.margin.mail"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "studio.margin.mail"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "app",
      "dmg",
      "appimage",
      "deb",
      "nsis",
      "msi"
    ],
    "category": "Productivity",
    "shortDescription": "A calm, keyboard-first mail client for Gmail",
    "longDescription": "New senders wait at the door until you let them in, people and newsletters and receipts live in three separate boxes, and every decision you make is kept beside the mail rather than inside it.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
